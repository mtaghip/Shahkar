// Shahkar Carpets — data model (PostgreSQL, via Prisma)

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Vercel's Neon integration is connected with the DATABASE1 prefix.
  // Use its direct URL so migrations and runtime queries share the same database.
  url      = env("DATABASE1_DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("customer") // "customer" | "admin"
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  tag          String // e.g. "Antique · c. 1910"
  meta         String // e.g. "3.62 × 2.71 m · wool on cotton"
  pricePence   Int // stored in pence
  priceFrom    Boolean     @default(false) // renders "from £x"
  category     String // "antique" | "contemporary"
  description  String
  provenance   String
  imageCaption String // placeholder caption / alt text for the main photo
  imageIds     String[]    @default([])
  status       String      @default("ACTIVE")
  sku          String      @default("")
  stock        Int         @default(1)
  reserved     Boolean     @default(false)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  email      String
  name       String
  phone      String?
  address    String
  totalPence Int
  status     String      @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | CANCELLED
  userId     String?
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  items      OrderItem[]
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String // snapshot of the product name at purchase time
  pricePence Int // snapshot of unit price
  qty        Int     @default(1)
}

model Media {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())
}

model Customer {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  phone            String   @default("")
  address          String   @default("")
  notes            String   @default("")
  tags             String   @default("")
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
  messages         EmailMessage[]
}

model EmailMessage {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  recipient  String
  subject    String
  body       String
  status     String   @default("DRAFT")
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
  sentAt     DateTime?
  @@index([customerId, createdAt])
}
