// Shahkar Carpets — data model (PostgreSQL, via Prisma)

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Vercel's Neon integration is connected with the DATABASE1 prefix.
  // Use its direct URL so migrations and runtime queries share the same database.
  url      = env("DATABASE1_DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("customer") // "customer" | "admin"
  sessionVersion Int    @default(0) // bump to sign out every existing session
  createdAt    DateTime @default(now())
  orders       Order[]
  resetTokens  PasswordResetToken[]
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  tag          String // e.g. "Antique · c. 1910"
  meta         String // e.g. "3.62 × 2.71 m · wool on cotton"
  pricePence   Int // stored in pence
  priceFrom    Boolean     @default(false) // renders "from £x"
  category     String // "antique" | "contemporary"
  description  String
  provenance   String
  specs        String      @default("") // "Label: value" per line
  imageCaption String // placeholder caption / alt text for the main photo
  imageIds     String[]    @default([])
  status       String      @default("ACTIVE")
  sku          String      @default("")
  stock        Int         @default(1)
  reserved     Boolean     @default(false)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]

  @@index([status, category])
  @@index([imageIds], type: Gin) // speeds up "which product owns this photo?"
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  email      String
  name       String
  phone      String?
  address    String
  totalPence Int // grand total = items subtotal + shippingPence
  shippingPence     Int    @default(0)
  shippingMethod    String @default("")
  status     String      @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | REFUNDED | CANCELLED
  fulfillmentStatus String @default("UNFULFILLED") // UNFULFILLED | FULFILLED
  trackingCarrier   String @default("")
  trackingNumber    String @default("")
  trackingUrl       String @default("")
  paymentProvider   String @default("") // "stripe" | "offline" | ""
  stripeSessionId   String?
  stripePaymentIntentId String?
  paidAt     DateTime?
  fulfilledAt DateTime?
  userId     String?
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  items      OrderItem[]
  returns    Return[]
  createdAt  DateTime    @default(now())
}

model Return {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String   @default("")
  status    String   @default("REQUESTED") // REQUESTED | APPROVED | RECEIVED | REFUNDED | DECLINED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String // snapshot of the product name at purchase time
  pricePence Int // snapshot of unit price
  qty        Int     @default(1)
}

model Media {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())
}

model Customer {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  phone            String   @default("")
  address          String   @default("")
  notes            String   @default("")
  tags             String   @default("")
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
  messages         EmailMessage[]
}

model EmailMessage {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  recipient  String
  subject    String
  body       String
  status     String   @default("DRAFT")
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
  sentAt     DateTime?
  @@index([customerId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the emailed token; the token itself is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String   @default("")
  action     String
  target     String   @default("")
  detail     String   @default("")
  createdAt  DateTime @default(now())
  @@index([createdAt])
}
