# PostgreSQL connection string.
# Local dev (see README for how to start a local Postgres):
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/shahkar?schema=public"
# Hosted (Neon / Supabase / Vercel Postgres) looks like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@shahkarcarpets.co.uk"
ADMIN_PASSWORD="shahkar-admin"
