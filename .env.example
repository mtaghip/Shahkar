# ---- Database (PostgreSQL) ----
# The schema reads DATABASE1_DATABASE_URL_UNPOOLED (the name Vercel's Neon
# integration sets). For local dev, point it at your local Postgres:
DATABASE1_DATABASE_URL_UNPOOLED="postgresql://postgres:devpassword@localhost:5432/shahkar?schema=public"

# ---- Auth ----
# Sign-in is disabled in production until this is set. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Seed admin account (created by `npm run db:seed`) ----
ADMIN_EMAIL="admin@shahkarcarpets.co.uk"
ADMIN_PASSWORD="shahkar-admin"

# ---- Payments (Stripe) — optional ----
# When unset, checkout runs in "reserve & arrange payment" mode (no card taken).
# When set, checkout redirects to Stripe Checkout and orders are marked paid by
# the webhook at /api/webhooks/stripe.
STRIPE_SECRET_KEY=""
# From the Stripe webhook endpoint you create for /api/webhooks/stripe:
STRIPE_WEBHOOK_SECRET=""

# ---- Transactional & customer email (Resend) — optional ----
# Verify a sending domain in Resend, then set these. Without them, order and
# admin emails are skipped (the order still succeeds).
RESEND_API_KEY=""
EMAIL_FROM="Shahkar Carpets <orders@your-verified-domain.co.uk>"
# EMAIL_REPLY_TO="hello@your-domain.co.uk"   # optional

# ---- Site & business details (public; shown in footer, legal pages, invoices) ----
# NEXT_PUBLIC_SITE_URL="https://www.shahkarcarpets.co.uk"
# NEXT_PUBLIC_COMPANY_NAME="Shahkar Carpets"
# NEXT_PUBLIC_COMPANY_LEGAL_NAME="Shahkar Carpets Ltd"
# NEXT_PUBLIC_COMPANY_NUMBER="01234567"          # leave unset until registered
# NEXT_PUBLIC_VAT_NUMBER="GB123456789"            # leave unset unless VAT-registered
# NEXT_PUBLIC_COMPANY_ADDRESS="Registered office address"
# NEXT_PUBLIC_CONTACT_EMAIL="hello@your-domain.co.uk"
# NEXT_PUBLIC_CONTACT_PHONE="01451 000 000"
# NEXT_PUBLIC_SHOWROOM_ADDRESS="Line 1|Town|County POSTCODE"   # "|" separates lines
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourhandle"

# ---- VAT ----
# Setting NEXT_PUBLIC_VAT_NUMBER (above) shows the VAT included on orders and issues VAT invoices.
# Set to "true" if you sell antiques under the second-hand margin scheme (VAT then is not itemised for them).
# VAT_MARGIN_SCHEME_ANTIQUES="true"
