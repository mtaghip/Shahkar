# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@shahkarcarpets.co.uk"
ADMIN_PASSWORD="shahkar-admin"
